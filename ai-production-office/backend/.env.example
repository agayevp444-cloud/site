# Anthropic API açarı (https://console.anthropic.com). Heç vaxt git-ə commit etməyin.
ANTHROPIC_API_KEY=

# Agentlərin istifadə etdiyi Claude modeli
AGENT_MODEL=claude-opus-5-5

# Düşünmə səviyyəsi: low | medium | high | xhigh | max
AGENT_EFFORT=medium
DIRECTOR_EFFORT=high

# Eyni anda işləyə bilən agent sayı
MAX_CONCURRENT_AGENTS=4

# Bir tapşırıq daxilində maksimum agent addımı (Claude sorğusu)
MAX_AGENT_STEPS=12

# Keyfiyyət nəzarətinin eyni tapşırığı geri qaytara biləcəyi maksimum dəfə
MAX_REVISIONS=2

# Tədqiqatçı üçün Anthropic veb axtarışı (true/false)
ENABLE_WEB_SEARCH=true

# Model imtina etdikdə server tərəfli ehtiyat modelə keçid (true/false)
ENABLE_FALLBACK=true

# Verilənlər bazası (SQLite və ya PostgreSQL URL)
DATABASE_URL=sqlite:///./data/office.db

# Agentlərin fayl yarada biləcəyi iş qovluğu (LUT, media və s.)
WORKSPACE_DIR=./workspace

# Frontend ünvanı (CORS üçün)
FRONTEND_ORIGIN=http://localhost:3000
